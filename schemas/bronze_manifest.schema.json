{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thesis.local/schemas/bronze_manifest.schema.json",
  "title": "Bronze File Manifest",
  "description": "One row per source file or source record accepted for batch ingestion. Binary payloads remain in the raw landing Volume.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "modality",
    "source_dataset",
    "source_version",
    "source_record_key",
    "raw_uri",
    "file_checksum",
    "file_format",
    "source_metadata",
    "ingestion_run_id",
    "ingested_at",
    "schema_version",
    "pipeline_version",
    "deidentification_status"
  ],
  "properties": {
    "record_id": {"type": "string", "minLength": 1},
    "subject_id_hash": {"type": ["string", "null"]},
    "modality": {"enum": ["physiological_signals", "ecg", "ppg", "respiration", "respiratory_audio", "chest_xray"]},
    "source_dataset": {"type": "string", "minLength": 1},
    "source_version": {"type": "string", "minLength": 1},
    "source_record_key": {"type": "string", "minLength": 1},
    "event_timestamp": {"type": ["string", "null"], "format": "date-time"},
    "time_precision": {"type": ["string", "null"]},
    "raw_uri": {"type": "string", "minLength": 1},
    "file_checksum": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "file_format": {"type": "string", "minLength": 1},
    "source_metadata": {"type": "object"},
    "ingestion_run_id": {"type": "string", "minLength": 1},
    "ingested_at": {"type": "string", "format": "date-time"},
    "schema_version": {"type": "string", "minLength": 1},
    "pipeline_version": {"type": "string", "minLength": 1},
    "license_reference": {"type": ["string", "null"]},
    "deidentification_status": {"enum": ["source_deidentified", "pseudonymized", "unknown"]}
  }
}
